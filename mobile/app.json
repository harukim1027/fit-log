{
  "expo": {
    "name": "fitlog",
    "slug": "fitlog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSHealthShareUsageDescription": "체중, 체지방률, 근육량, 키 데이터를 읽어 피트니스 추적에 활용합니다.",
        "NSHealthUpdateUsageDescription": "운동 및 신체 데이터를 Apple Health에 저장합니다.",
        "NSCameraUsageDescription": "음식 사진을 찍어 칼로리를 분석합니다.",
        "NSPhotoLibraryUsageDescription": "갤러리에서 음식 사진을 선택해 칼로리를 분석합니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      [
        "react-native-health/app.plugin.js",
        {
          "healthSharePermission": "체중, 체지방률, 근육량, 키 데이터를 읽어 피트니스 추적에 활용합니다.",
          "healthUpdatePermission": "운동 및 신체 데이터를 Apple Health에 저장합니다."
        }
      ]
    ],
    "scheme": "fitlog"
  }
}
