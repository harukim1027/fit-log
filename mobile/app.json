{
  "expo": {
    "name": "fitlog",
    "slug": "fitlog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/d1dd85f4-b4bf-410f-8756-e9af669b078f",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.harulog.app",
      "infoPlist": {
        "NSCameraUsageDescription": "음식 사진을 찍어 칼로리를 분석합니다.",
        "NSPhotoLibraryUsageDescription": "갤러리에서 음식 사진을 선택해 칼로리를 분석합니다.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.6407997968-nlvadp68cnca0o3rf6a420ms3d1a8lpp"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.6407997968-nlvadp68cnca0o3rf6a420ms3d1a8lpp"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.harulog.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image-picker",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#3D8BE0",
          "sounds": []
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "your-sentry-org-slug",
          "project": "fitlog"
        }
      ]
    ],
    "scheme": "fitlog",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d1dd85f4-b4bf-410f-8756-e9af669b078f"
      }
    },
    "owner": "yoonakim1027"
  }
}
