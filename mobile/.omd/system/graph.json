          "선택적 단위 접미(micro)",
          "선택적 스테퍼"
        ],
        "id": "input",
        "interaction": {
          "kind": "interactive",
          "state_applicability": {
            "default": {
              "applicability": "applicable"
            },
            "disabled": {
              "applicability": "applicable"
            },
            "error": {
              "applicability": "applicable"
            },
            "focus-visible": {
              "applicability": "applicable"
            },
            "hover": {
              "applicability": "not-applicable",
              "reason": "iOS 터치 전용 서피스라 hover 입력이 없다."
            },
            "loading": {
              "applicability": "not-applicable",
              "reason": "입력 필드 자체는 비동기 로드를 갖지 않는다. 로딩은 저장 버튼이 표시한다."
            },
            "success": {
              "applicability": "not-applicable",
              "reason": "성공 상태는 필드가 아니라 저장 결과 토스트가 알린다."
            }
