          "state_applicability": {
            "default": {
              "applicability": "applicable"
            },
            "disabled": {
              "applicability": "applicable"
            },
            "error": {
              "applicability": "applicable"
            },
            "focus-visible": {
              "applicability": "applicable"
            },
            "hover": {
              "applicability": "not-applicable",
              "reason": "iOS 터치 전용 서피스라 hover 입력이 없다."
            },
            "loading": {
              "applicability": "not-applicable",
              "reason": "행 단위 로딩은 표시하지 않는다. 로딩은 부모 리스트가 스켈레톤으로 대신한다."
            },
